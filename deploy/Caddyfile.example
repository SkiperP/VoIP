# Add these two site blocks to the EXISTING Caddyfile.
# Do not start a second Caddy and do not replace the current app's site.
#
# Replace 203.0.113.10 with the VPS public IPv4.

call.203.0.113.10.sslip.io {
	reverse_proxy 127.0.0.1:3080
}

livekit.203.0.113.10.sslip.io {
	reverse_proxy 127.0.0.1:7880 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
	}
}
