# Existing Caddy on the VPS. Do not bind a second Caddy to 80/443.
#
# AdminVPS / TSPU in Russian networks drop some TLS 1.3 ClientHellos.
# HTTPS sites must pin TLS 1.2 (see the (https) snippet).
#
#   https://badger-budget.ru/call/
#   wss://badger-budget.ru/lk
#
# Put /call and /lk handles at the TOP of the existing (routes) snippet,
# before the catch-all reverse_proxy to panel.
#
# A bare `redir` is compiled BEFORE `handle`. Wrap HTTPS catch-all:
#   handle { redir https://{host}{uri} 308 }

(tls12) {
	tls {
		protocols tls1.2 tls1.2
	}
}

# handle /call {
# 	redir * /call/ 302
# }
# handle /call* {
# 	uri strip_prefix /call
# 	header Permissions-Policy "microphone=(self), camera=()"
# 	reverse_proxy host.docker.internal:3080
# }
# handle /lk {
# 	redir * /lk/ 302
# }
# handle /lk/* {
# 	uri strip_prefix /lk
# 	reverse_proxy host.docker.internal:7880 {
# 		flush_interval -1
# 	}
# }

call.badger-budget.ru {
	import tls12
	header Permissions-Policy "microphone=(self), camera=()"
	handle /lk {
		redir * /lk/ 302
	}
	handle /lk/* {
		uri strip_prefix /lk
		reverse_proxy host.docker.internal:7880 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy host.docker.internal:3080
	}
}

livekit.badger-budget.ru {
	import tls12
	reverse_proxy host.docker.internal:7880 {
		flush_interval -1
	}
}
