# HTTPS on call.badger-budget.ru hangs from many networks (Client Hello
# never reaches the VPS). Serve Line on the apex instead:
#
#   https://badger-budget.ru/call/
#   wss://badger-budget.ru/lk
#
# Put these handles at the TOP of the existing (routes) snippet,
# before the catch-all reverse_proxy to panel.

# handle /call {
# 	redir * /call/ 302
# }
# handle_path /call/* {
# 	header Permissions-Policy "microphone=(self), camera=()"
# 	reverse_proxy host.docker.internal:3080
# }
# handle /lk {
# 	redir * /lk/ 302
# }
# handle_path /lk/* {
# 	reverse_proxy host.docker.internal:7880 {
# 		flush_interval -1
# 	}
# }

# Optional extra hostnames (HTTP works; HTTPS on these names often hangs):

call.badger-budget.ru {
	header Permissions-Policy "microphone=(self), camera=()"
	reverse_proxy host.docker.internal:3080
}

livekit.badger-budget.ru {
	reverse_proxy host.docker.internal:7880 {
		flush_interval -1
	}
}
