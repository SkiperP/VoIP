# Add these two site blocks to the EXISTING Caddyfile on the VPS.
# Do not start a second Caddy. Do not replace the badger-budget.ru site
# that already serves the current app.
#
# DNS (same A record as badger-budget.ru):
#   call.badger-budget.ru      A
#   livekit.badger-budget.ru   A
#
# Wait until both names resolve to this server, then reload Caddy.
# Caddy will request Let's Encrypt certs on the existing :80/:443 listener.

call.badger-budget.ru {
	reverse_proxy 127.0.0.1:3080
}

livekit.badger-budget.ru {
	reverse_proxy 127.0.0.1:7880 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
	}
}
