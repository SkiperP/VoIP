{
	admin off
	auto_https off
}

# Internal HTTP edge for the public HTTPS tunnel (Pinggy over SSH/443).

:80 {
	header Permissions-Policy "microphone=(self), camera=()"

	handle /lk {
		redir * /lk/ 302
	}

	handle /lk/* {
		uri strip_prefix /lk
		reverse_proxy livekit:7880 {
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:3080 {
			header_up X-Forwarded-Proto https
		}
	}
}
