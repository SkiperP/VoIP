# Copy to deploy/.env (or repo-root .env for local npm run dev).
# Generate a secret: openssl rand -hex 32

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=thisisnotsecretthisisnotsecret1234

# Fallback LiveKit URL when the request is not behind a reverse proxy.
# Behind Caddy/cloudflared the API derives wss://<host>/lk from
# X-Forwarded-Proto + Host.
# Local:  ws://127.0.0.1:7880
LIVEKIT_URL=ws://127.0.0.1:7880

# Port for the token API + static UI (published on loopback only)
APP_PORT=3080

# Production UI is served at /call/ (Vite base + API path strip).
# VITE_BASE=/call/

# Optional override for the public HTTPS URL shown in the UI.
# Normally written to deploy/runtime/https-url by the Pinggy tunnel.
# HTTPS_PUBLIC_URL=https://xxxx.free.pinggy.net
