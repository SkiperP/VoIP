# Copy to deploy/.env (or repo-root .env for local npm run dev).
# Generate a secret: openssl rand -hex 32

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=thisisnotsecretthisisnotsecret1234

# URL the *browser* uses to reach LiveKit signaling.
# Local:  ws://127.0.0.1:7880
# VPS:    wss://livekit.badger-budget.ru
LIVEKIT_URL=ws://127.0.0.1:7880

# Port for the token API + static UI (published on loopback only)
APP_PORT=3080
