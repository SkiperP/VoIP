# Copy to deploy/.env (or repo-root .env for local npm run dev).
# Generate a secret: openssl rand -hex 32

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=thisisnotsecretthisisnotsecret1234

# URL the browser uses when the request is not behind a reverse proxy.
# Behind Caddy the API derives wss://<host>/lk from X-Forwarded-Proto + Host.
# Local:  ws://127.0.0.1:7880
# VPS:    wss://badger-budget.ru/lk
LIVEKIT_URL=ws://127.0.0.1:7880

APP_PORT=3080

# Production UI is served at https://badger-budget.ru/call/
# VITE_BASE=/call/
